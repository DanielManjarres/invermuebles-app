{
  "name": "invermuebles-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prestart": "prisma migrate deploy",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "db:seed": "prisma db seed",
    "test": "npm run test:types && npm run lint && npm run test:coverage && npm run test:system",
    "test:types": "tsc --noEmit",
    "test:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/unit/*.test.mjs",
    "test:integration": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/integration/*.test.mjs",
    "test:system": "next build && node --test tests/system/*.test.mjs",
    "test:coverage": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --experimental-test-coverage --test-coverage-lines=95 --test-coverage-branches=90 --test-coverage-functions=95 --test tests/unit/*.test.mjs tests/integration/*.test.mjs",
    "test:security": "npm audit --omit=dev"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.13.0",
    "lucide-react": "^0.468.0",
    "next": "^16.3.1",
    "prisma": "^6.13.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.3.1",
    "typescript": "^5.7.0"
  }
}
