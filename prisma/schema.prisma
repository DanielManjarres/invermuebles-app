generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String?
  role         UserRole @default(SECRETARY)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stockMovements StockMovement[]
  salePayments   SalePayment[]
}

model ProductType {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes  ProductClass[]
  products Product[]
}

model ProductClass {
  id            String      @id @default(cuid())
  name          String
  productType   ProductType @relation(fields: [productTypeId], references: [id], onDelete: Restrict)
  productTypeId String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  products Product[]

  @@unique([name, productTypeId])
}

model Product {
  id             String       @id @default(cuid())
  name           String
  reference      String       @unique
  details        String
  cost           Decimal      @db.Decimal(12, 2)
  salePrice      Decimal      @db.Decimal(12, 2)
  stock          Int          @default(0)
  visible        Boolean      @default(false)
  imageUrl       String?
  productType    ProductType  @relation(fields: [productTypeId], references: [id], onDelete: Restrict)
  productTypeId  String
  productClass   ProductClass @relation(fields: [productClassId], references: [id], onDelete: Restrict)
  productClassId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  stockMovements StockMovement[]
  orderItems     OrderItem[]
  saleItems      SaleItem[]
}

model StockMovement {
  id            String            @id @default(cuid())
  product       Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId     String
  type          StockMovementType
  quantity      Int
  previousStock Int
  nextStock     Int
  reason        String
  note          String?
  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId        String?
  createdAt     DateTime          @default(now())
  archivedAt    DateTime?
}

model Customer {
  id                String         @id @default(cuid())
  fullName          String
  document          String?        @unique
  phone             String
  email             String?
  address           String?
  neighborhood      String?
  city              String?
  referenceName     String?
  referenceRelation String?
  referencePhone    String?
  status            CustomerStatus @default(ACTIVE)
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  orders  Order[]
  credits Credit[]
  sales   Sale[]
}

model Order {
  id         String       @id @default(cuid())
  customer   Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId String?
  status     OrderStatus  @default(PENDING)
  channel    OrderChannel @default(WHATSAPP)
  notes      String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  items OrderItem[]
  sale  Sale?
}

model OrderItem {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId String
  quantity  Int
  createdAt DateTime @default(now())
}

model Sale {
  id         String     @id @default(cuid())
  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId String?
  order      Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId    String?    @unique
  source     SaleSource @default(LOCAL)
  type       SaleType   @default(CASH)
  status     SaleStatus @default(COMPLETED)
  paymentMethod String  @default("CASH")
  amountPaid Decimal    @default(0) @db.Decimal(12, 2)
  balance    Decimal    @default(0) @db.Decimal(12, 2)
  sistecreditoApproval String?
  reservedUntil DateTime?
  stockApplied Boolean @default(true)
  notes      String?
  total      Decimal    @default(0) @db.Decimal(12, 2)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  items SaleItem[]
  payments SalePayment[]
  credit Credit?
}

model SaleItem {
  id               String   @id @default(cuid())
  sale             Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId           String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId        String
  productName      String
  productReference String
  productCategory  String
  productClass     String
  quantity         Int
  unitPrice        Decimal  @db.Decimal(12, 2)
  cost             Decimal  @db.Decimal(12, 2)
  lineTotal        Decimal  @db.Decimal(12, 2)
  createdAt        DateTime @default(now())
}

model Credit {
  id         String       @id @default(cuid())
  customer   Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerId String
  sale       Sale?        @relation(fields: [saleId], references: [id], onDelete: Restrict)
  saleId     String?      @unique
  total      Decimal      @db.Decimal(12, 2)
  principal  Decimal      @db.Decimal(12, 2)
  interestRate Decimal    @db.Decimal(5, 2)
  outstandingPrincipal Decimal @db.Decimal(12, 2)
  interestBalance Decimal @db.Decimal(12, 2)
  months     Int
  status     CreditStatus @default(ACTIVE)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  payments CreditPayment[]
  salePayments SalePayment[]
}

model SalePayment {
  id              String        @id @default(cuid())
  sale            Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId          String
  credit          Credit?       @relation(fields: [creditId], references: [id], onDelete: SetNull)
  creditId        String?
  amount          Decimal       @db.Decimal(12, 2)
  method          PaymentMethod
  reference       String?
  note            String?
  principalAmount Decimal?      @db.Decimal(12, 2)
  interestAmount  Decimal?      @db.Decimal(12, 2)
  isInitial       Boolean       @default(false)
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId          String?
  createdAt       DateTime      @default(now())

  @@index([saleId, isInitial])
}

model CreditPayment {
  id       String   @id @default(cuid())
  credit   Credit   @relation(fields: [creditId], references: [id], onDelete: Cascade)
  creditId String
  amount   Decimal  @db.Decimal(12, 2)
  paidAt   DateTime @default(now())
  note     String?
}

enum UserRole {
  ADMIN
  SECRETARY
}

enum StockMovementType {
  ENTRY
  EXIT
  ADJUSTMENT
}

enum OrderStatus {
  PENDING
  CONTACTED
  CONFIRMED
  CANCELLED
}

enum OrderChannel {
  WHATSAPP
  STORE
}

enum SaleSource {
  LOCAL
  ORDER
}

enum SaleType {
  CASH
  CREDIT
  RESERVED
  CREDIT_CASH
  SISTECREDITO
}

enum SaleStatus {
  COMPLETED
  PENDING_PAYMENT
  PENDING_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH
  TRANSFER
}

enum CustomerStatus {
  ACTIVE
  OVERDUE
  INACTIVE
  BLOCKED
}

enum CreditStatus {
  ACTIVE
  PAID
  OVERDUE
  CANCELLED
}
