# Base de desarrollo. No uses aquí la base de producción para las pruebas.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Reemplaza ambos valores antes de ejecutar el seed o publicar la aplicación.
ADMIN_PASSWORD="reemplaza-por-una-contrasena-segura"
SESSION_SECRET="reemplaza-por-un-secreto-largo-aleatorio-e-independiente"

# Opcionales:
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/TEST_DATABASE"
# UPLOAD_DIR="C:/ruta/persistente/invermuebles/productos"
